# Molde de deploy/aws/secretos/mq-1.env y mq-2.env (iguales: los dos nodos de RabbitMQ comparten cookie y clave).
# 03-subir.sh los crea con claves aleatorias si faltan y los guarda en /biblioteca/mq-1/env y /biblioteca/mq-2/env.
# En la máquina, mq/rabbit/secretos.sh los convierte en rabbitmq.conf y erlang.cookie. No se versionan.
RABBITMQ_USER=biblioteca
RABBITMQ_PASSWORD=
RABBITMQ_COOKIE=
